{
  "name": "Planificateur rénovation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "app.py"] },
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"] }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt",
  "postAttachCommand": { "server": "streamlit run app.py" },
  "portsAttributes": { "8501": { "label": "Application", "onAutoForward": "openPreview" } },
  "forwardPorts": [8501]
}
